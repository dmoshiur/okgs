# Turso / libSQL (leave unset in development to use the local local.db file)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin access — change these before deploying
ADMIN_EMAIL=admin@okgs.info
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-string
# Separate 32+ character secret for AES-256-GCM encryption of SuperAdmin SMTP credentials.
# If omitted, SESSION_SECRET is used; keep the same secret across all app instances.
SMTP_CONFIG_SECRET=replace-with-a-different-long-random-string

# Canonical origin used for metadata, sitemap, robots and JSON-LD
NEXT_PUBLIC_SITE_URL=https://omarkgschool.com

# Cloudinary — one place for every upload (admin studio, club admins, fair entries).
# Preferred: server-side *signed* uploads. The server keeps the secret and hands the
# browser a short-lived signature, so nothing secret is ever shipped to a visitor.
# The three values must come from the SAME product environment or every upload
# answers 401 "Invalid Signature".
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Signature hash: sha1 (Cloudinary's default) or sha256 (only if the product
# environment has been locked to SHA-256). Both ends must agree, so this is read
# server-side only.
CLOUDINARY_SIGNATURE_ALGORITHM=sha1
# Optional legacy fallback — only used when no API key/secret is present.
# If you use it, the preset MUST be an *unsigned* preset
# (Cloudinary → Settings → Upload → Upload presets → Signing Mode: unsigned).
CLOUDINARY_UPLOAD_PRESET=
# Optional — folder inside Cloudinary (default: okgs) and a client-side size guard (default: 12 MB)
CLOUDINARY_FOLDER=okgs/clubs
CLOUDINARY_MAX_BYTES=12582912

# Club admin accounts — one per club folder (clubs/alssm, clubs/alpcg, …).
# Default: <slug>@okgs.info with this password (falls back to okgs1234).
CLUB_ADMIN_PASSWORD=okgs1234

# Default password for seeded students / alumni (they can change it after login).
PORTAL_DEFAULT_PASSWORD=okgs1234
# Club hosting — every club site lives on its own subdomain and nowhere else:
#   alssm.okgs.info, aypg.okgs.info, …   (middleware.ts rewrites them to the
#   internal /club-site/<slug> route of this same deployment).
# Add a wildcard domain (*.okgs.info) at your host — no per-club deploy, no
# per-club build. Each club.json carries its own `subdomain`, and a club may
# point at a fully custom domain instead (Site address field in the club studio).
# The base domain below is only the fallback for a club with no subdomain saved.
NEXT_PUBLIC_CLUB_SITE_DOMAIN=okgs.info
# Old bookmarked paths (/clubs/<slug>/site) 308-redirect to the subdomain, so
# nothing has to be re-printed when a club moves onto its own address.

# Transactional email — password-reset links and account invitations.
# With no provider configured, the reset link is returned in the API response
# (development only); /admin/users shows a one-time link the SuperAdmin can share.
# auto: saved SMTP, then environment SMTP; Resend if no SMTP is configured or a
#       connection fails before submission. Ambiguous send failures are NOT retried.
# resend: HTTPS API only, ignoring saved SMTP (recommended when Render/your host
#         blocks outbound SMTP ports). Requires a verified sender domain in Resend.
# smtp: SMTP only, no API fallback.
MAIL_PROVIDER=auto
RESEND_API_KEY=
MAIL_FROM=OKGS <no-reply@okgs.info>

# Optional SMTP fallback when no enabled database SMTP configuration exists.
# Prefer SuperAdmin → SMTP Settings (encrypted credentials at rest).
# Default IPv4 resolution avoids ENETUNREACH on IPv4-only hosts. This also applies
# to database SMTP settings. Use 0 for automatic/dual-stack or 6 for IPv6-only.
# IP literals are used as supplied. TLS hostname verification remains enabled.
# IPv4 does NOT bypass a hosting provider's SMTP port restrictions.
SMTP_ADDRESS_FAMILY=4
# Gmail: smtp.gmail.com / 465 / true + app password.
# SendGrid: smtp.sendgrid.net / 587 / false + username apikey.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OKGS
SMTP_REPLY_TO=
