# Turso / libSQL (leave unset in development to use the local local.db file)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin access — change these before deploying
ADMIN_EMAIL=admin@okgs.info
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-string

# Canonical origin used for metadata, sitemap, robots and JSON-LD
NEXT_PUBLIC_SITE_URL=https://okgs.info

# Cloudinary — direct browser uploads from the admin studio.
# The preset MUST be an *unsigned* preset (Settings → Upload → Upload presets → Signing Mode: unsigned),
# because the upload is sent from the browser and can never carry an API secret.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
# Optional — folder inside Cloudinary (default: okgs) and a client-side size guard (default: 12 MB)
CLOUDINARY_FOLDER=okgs/clubs
CLOUDINARY_MAX_BYTES=12582912
